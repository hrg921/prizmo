# Postgres 접속 문자열. Vercel에서 Neon을 연결하면 DATABASE_URL이 자동으로 들어갑니다.
# 로컬에서 비워 두면 ./data/pglite 에 임베디드 Postgres(PGlite)를 씁니다.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 세션 쿠키 서명 키 (운영에서 필수, 32자 이상 랜덤 문자열)
SESSION_SECRET=change-me

# /admin 접근 토큰 (운영에서 필수, 개발 모드에서는 없으면 바로 열림)
# ADMIN_TOKEN=
